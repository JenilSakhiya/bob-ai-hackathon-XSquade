# CyberSentinel Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default for MVP)
DATABASE_URL=sqlite:///./cybersentinel.db

# AI Provider Configuration
# Set to 'mock' for offline deterministic AI analyst (default, no credentials needed)
# Set to 'openai' for OpenAI/Ollama/Open-source LLM endpoint
AI_PROVIDER=mock

# Optional OpenAI / Compatible LLM settings (used only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenAI
AI_PROVIDER=openai
OPENAI_API_KEY=

# Google Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Groq (free tier available!)
AI_PROVIDER=groq
GROQ_API_KEY=
