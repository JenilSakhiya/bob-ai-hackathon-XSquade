# CyberSentinel Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default for MVP)
DATABASE_URL=sqlite:///./cybersentinel.db

# ─────────────────────────────────────────────────────────────
# AI Provider Configuration
# ─────────────────────────────────────────────────────────────
# Set to 'mock' for offline deterministic AI analyst (default, no credentials needed)
# Set to 'openai' for OpenAI / any OpenAI-compatible endpoint (Ollama, vLLM, etc.)
# Set to 'gemini' for Google Gemini
# Set to 'groq' for Groq (ultra-fast inference)
AI_PROVIDER=mock

# ─── OpenAI Settings (used when AI_PROVIDER=openai) ─────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Google Gemini Settings (used when AI_PROVIDER=gemini) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── Groq Settings (used when AI_PROVIDER=groq) ─────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
