# CyberSentinel Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default for MVP)
DATABASE_URL=sqlite:///./cybersentinel.db

# AI Provider Configuration — choose one: mock, openai, gemini, or groq.
# 'mock' is the offline deterministic analyst and needs no credentials.
AI_PROVIDER=mock

# Optional OpenAI / Compatible LLM settings (used only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# To use OpenAI, set AI_PROVIDER=openai above.
OPENAI_API_KEY=

# To use Google Gemini, set AI_PROVIDER=gemini above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# To use Groq, set AI_PROVIDER=groq above.
GROQ_API_KEY=
